SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=shule_db
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

REDIS_URL=redis://localhost:6379/0

# ── SMS (Notify Africa) ──────────────────────────────────────────────
# noop (default) records messages without sending; console also logs them;
# notify_africa sends for real and requires the three NOTIFY_AFRICA_* values.
SMS_BACKEND=noop
NOTIFY_AFRICA_BASE_URL=https://api.notify.africa
NOTIFY_AFRICA_API_TOKEN=
NOTIFY_AFRICA_SENDER_ID=
NOTIFY_AFRICA_TIMEOUT=15
# Guard rails (safe defaults shown). SMS_PRICE_PER_SEGMENT=0 hides the shilling
# estimate and shows segment counts only.
SMS_MAX_SEGMENTS=3
SMS_BATCH_RECIPIENT_CAP=500
SMS_PROVIDER_CHUNK_SIZE=100
SMS_PROVIDER_CHUNK_SLEEP=1.0
SMS_PRICE_PER_SEGMENT=0

MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=

FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# LICENSED_MODULES: the optional modules this school may use at all (what it
# has bought). Admin Panel → Modules switches modules on and off within this
# list. Commented out = every module is licensed.
# LICENSED_MODULES=exams,reports,fees,attendance,timetable,staff,boarding,transport,library,homepackages,communications,sms,documents,school_calendar,analytics
#
# ENABLED_MODULES: which modules start switched on, until an admin first saves
# on the Modules page (then the page decides and this line is ignored).
# Commented out = the default set in settings.py. Do NOT set it to an empty
# value — "ENABLED_MODULES=" means "nothing enabled".
# Available: exams,reports,fees,attendance,timetable,staff,boarding,transport,
# library,homepackages,communications,sms,documents,school_calendar,analytics
# ENABLED_MODULES=exams,reports,fees,attendance,timetable,staff,boarding,transport,library,homepackages,communications,sms,documents,school_calendar

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
DEMO_REQUEST_NOTIFY_EMAIL=
