# ── SMS ──────────────────────────────────────────────────────────────
# noop (default) records messages without sending; console also logs them.
# Set SMS_BACKEND to the live backend and fill the three credentials below
# to actually deliver. Startup fails loudly if any is missing.
SMS_BACKEND=noop
NOTIFY_AFRICA_BASE_URL=https://api.notify.africa
NOTIFY_AFRICA_API_TOKEN=
NOTIFY_AFRICA_SENDER_ID=
NOTIFY_AFRICA_TIMEOUT=15

MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=

FRONTEND_URL=https://shule.ac.tz
CORS_ALLOWED_ORIGINS=https://shule.ac.tz,https://www.shule.ac.tz
CSRF_TRUSTED_ORIGINS=https://shule.ac.tz,https://www.shule.ac.tz

