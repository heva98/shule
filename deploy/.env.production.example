# ── SMS ──────────────────────────────────────────────────────────────
# noop (default) records messages without sending; console also logs them.
# Set SMS_BACKEND to the live backend and fill the three credentials below
# to actually deliver. Startup fails loudly if any is missing.
SMS_BACKEND=noop
NOTIFY_AFRICA_BASE_URL=https://api.notify.africa
NOTIFY_AFRICA_API_TOKEN=
NOTIFY_AFRICA_SENDER_ID=
NOTIFY_AFRICA_TIMEOUT=15

MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=

FRONTEND_URL=https://shule.ac.tz
CORS_ALLOWED_ORIGINS=https://shule.ac.tz,https://www.shule.ac.tz
CSRF_TRUSTED_ORIGINS=https://shule.ac.tz,https://www.shule.ac.tz

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@shule.ac.tz
DEMO_REQUEST_NOTIFY_EMAIL=

# ── Modules ──────────────────────────────────────────────────────────────────
# LICENSED_MODULES: the optional modules this school may use at all. Set it at
# setup to what the school has bought. Admins then switch modules on and off in
# Admin Panel → Modules, but only within this list. Leave it commented out to
# license every module.
# Available: exams,reports,fees,attendance,timetable,staff,boarding,transport,
# library,homepackages,communications,sms,documents,school_calendar,analytics
# LICENSED_MODULES=exams,reports,fees,attendance,timetable,staff,boarding,transport,library,homepackages,communications,sms,documents,school_calendar,analytics
#
# ENABLED_MODULES: which licensed modules start switched on, until an admin
# first saves on the Modules page (after that, the page decides and this line
# is ignored). Leave it commented out for the default set in settings.py.
# ENABLED_MODULES=exams,reports,fees,attendance,timetable,staff,communications,sms,school_calendar,analytics
